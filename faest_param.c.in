size_t FAEST_CALLING_CONVENTION faest_@PARAM_L@_agg_aggregator_state_size(size_t signer_count) {
  const faest_paramset_t* params = faest_get_paramset(FAEST_@PARAM@);
  return faest_agg_aggregator_state_size(signer_count, params);
}

int FAEST_CALLING_CONVENTION faest_@PARAM_L@_agg_aggregator_init(void* state,
                                                                 const uint8_t* const* pks,
                                                                 size_t signer_count,
                                                                 const uint8_t* msg,
                                                                 size_t msg_len) {
  if (!pks) {
    return -1;
  }
  const faest_paramset_t* params = faest_get_paramset(FAEST_@PARAM@);
  /* Split per-signer public keys into (owf_input, owf_output) arrays. */
  if (signer_count == 0) {
    return -1;
  }
  const uint8_t** owf_inputs  = (const uint8_t**)malloc(signer_count * sizeof(uint8_t*));
  const uint8_t** owf_outputs = (const uint8_t**)malloc(signer_count * sizeof(uint8_t*));
  if (!owf_inputs || !owf_outputs) {
    free((void*)owf_inputs);
    free((void*)owf_outputs);
    return -1;
  }
  for (size_t j = 0; j < signer_count; ++j) {
    if (!pks[j]) {
      free((void*)owf_inputs);
      free((void*)owf_outputs);
      return -1;
    }
    owf_inputs[j]  = PK_INPUT(pks[j]);
    owf_outputs[j] = PK_OUTPUT(pks[j]);
  }
  int ret = faest_agg_aggregator_init((faest_agg_aggregator_state_t*)state, owf_inputs,
                                      owf_outputs, signer_count, msg, msg_len, params);
  free((void*)owf_inputs);
  free((void*)owf_outputs);
  return ret;
}

int FAEST_CALLING_CONVENTION faest_@PARAM_L@_agg_aggregator_round1(void* state,
                                                                   const uint8_t* const* msg1s,
                                                                   uint8_t* chall_1_out) {
  const faest_paramset_t* params = faest_get_paramset(FAEST_@PARAM@);
  return faest_agg_aggregator_round1((faest_agg_aggregator_state_t*)state, msg1s, chall_1_out,
                                     params);
}

int FAEST_CALLING_CONVENTION faest_@PARAM_L@_agg_aggregator_round2(void* state,
                                                                   const uint8_t* const* msg2s,
                                                                   uint8_t* chall_2_out) {
  const faest_paramset_t* params = faest_get_paramset(FAEST_@PARAM@);
  return faest_agg_aggregator_round2((faest_agg_aggregator_state_t*)state, msg2s, chall_2_out,
                                     params);
}

