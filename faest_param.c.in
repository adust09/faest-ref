                                                                   const uint8_t* const* msg3s) {
  const faest_paramset_t* params = faest_get_paramset(FAEST_@PARAM@);
  return faest_agg_aggregator_round3((faest_agg_aggregator_state_t*)state, msg3s, params);
}

int FAEST_CALLING_CONVENTION faest_@PARAM_L@_agg_aggregator_round4(void* state,
                                                                   uint8_t* chall_3_out,
                                                                   uint32_t* ctr_out) {
  const faest_paramset_t* params = faest_get_paramset(FAEST_@PARAM@);
  return faest_agg_aggregator_round4((faest_agg_aggregator_state_t*)state, chall_3_out, ctr_out,
                                     params);
}

int FAEST_CALLING_CONVENTION faest_@PARAM_L@_agg_aggregator_finalize(void* state,
                                                                     const uint8_t* const* msg5s,
                                                                     uint8_t* signature,
                                                                     size_t* signature_len) {
  const faest_paramset_t* params = faest_get_paramset(FAEST_@PARAM@);
  return faest_agg_aggregator_finalize((faest_agg_aggregator_state_t*)state, msg5s, signature,
                                       signature_len, params);
}

void FAEST_CALLING_CONVENTION faest_@PARAM_L@_agg_aggregator_clear(void* state) {
  const faest_paramset_t* params = faest_get_paramset(FAEST_@PARAM@);
  faest_agg_aggregator_clear((faest_agg_aggregator_state_t*)state, params);
}

int FAEST_CALLING_CONVENTION faest_@PARAM_L@_aggregate_verify(const uint8_t* const* pks,
                                                              size_t signer_count,
                                                              const uint8_t* message,
                                                              size_t message_len,
                                                              const uint8_t* signature,
                                                              size_t signature_len) {
  if (!pks || signer_count == 0) {
    return -1;
  }
  const faest_paramset_t* params = faest_get_paramset(FAEST_@PARAM@);
  const uint8_t** owf_inputs  = (const uint8_t**)malloc(signer_count * sizeof(uint8_t*));
  const uint8_t** owf_outputs = (const uint8_t**)malloc(signer_count * sizeof(uint8_t*));
  if (!owf_inputs || !owf_outputs) {
    free((void*)owf_inputs);
    free((void*)owf_outputs);
    return -1;
  }
  for (size_t j = 0; j < signer_count; ++j) {
    if (!pks[j]) {
      free((void*)owf_inputs);
      free((void*)owf_outputs);
      return -1;
    }
    owf_inputs[j]  = PK_INPUT(pks[j]);
    owf_outputs[j] = PK_OUTPUT(pks[j]);
  }
  int ret = faest_aggregate_verify(message, message_len, signature, signature_len, owf_inputs,
                                   owf_outputs, signer_count, params);
  free((void*)owf_inputs);
  free((void*)owf_outputs);
  return ret;
}

